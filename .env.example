# このファイルをコピーして .env / .env.local を作成してください。
# 実際の値は絶対にコミットしないこと。本番値はVercel等の環境変数管理画面で設定する。
# 銀行口座情報・パスワード・秘密鍵はこのファイル/コードに直接書かない (SECURITY.md, ENVIRONMENT_VARIABLES.md 参照)

# --- Database ---
# 開発: SQLite (デフォルト、変更不要)
# 本番: クラウドPostgres接続文字列 (例: Neon, Supabase)
DATABASE_URL="file:./dev.db"

# --- Auth ---
# openssl rand -base64 32 等で生成したランダム文字列
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- AI API ---
# 未設定時はモック応答で動作する(README参照)。取得後にここへ設定。
AI_API_KEY=""
AI_API_PROVIDER="anthropic"
# AIの月間利用回数の上限(任意。空欄は無制限)。AI費用の青天井を防ぐため本番では設定を推奨。
# 数えるのは実際にAIを呼んで成功した回数のみ(失敗・AI未設定時の簡易判定は数えない)。
# 会社ごとの上限は、料金プラン(/admin/plans の「AI利用回数の上限」)が優先される。
# プランに上限がない会社(モニター等)には AI_MONTHLY_LIMIT_PER_COMPANY を使う。
# AI_MONTHLY_LIMIT_TOTAL は全社合計の上限(最後の安全装置)。
AI_MONTHLY_LIMIT_PER_COMPANY=""
AI_MONTHLY_LIMIT_TOTAL=""
# 利用者数・保存容量(MB)の上限(任意。空欄は無制限)。料金プランの値があればそちらが優先。
# 上限に達しても既存データの閲覧・編集は止めず、招待・アップロードだけを止める。
USER_LIMIT_PER_COMPANY=""
STORAGE_LIMIT_MB_PER_COMPANY=""

# --- 音声入力の文字起こしフォールバック(任意) ---
# ブラウザの音声認識(SpeechRecognition)が使えない/失敗した場合、録音した音声を
# サーバーへ送って文字起こしする経路で使う。AnthropicのAPIは音声を扱えないため
# 別サービス(例: OpenAI Whisper API等)の契約が別途必要。未設定時は「録音はできるが
# 文字起こしは利用できません」と案内し、テキスト直接入力を促す(src/lib/transcription.ts参照)。
TRANSCRIPTION_API_KEY=""

# --- App ---
APP_URL="http://localhost:3000"

# --- Googleログイン(任意) ---
# 未設定時は「Googleでログイン/登録」ボタンが非表示になるだけで、通常のメール登録・
# ログインには影響しない。Google Cloud ConsoleのOAuthクライアントで、承認済み
# リダイレクトURIに `{APP_URL}/api/auth/google/callback` を登録して取得する。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend, メール認証・パスワード再設定用) ---
# 未設定時はコンソールログ出力のみのモックで動作する(README参照)。
RESEND_API_KEY=""
EMAIL_FROM="genba-ai@example.com"

# --- Storage (S3互換, 本番用。開発中はローカル/uploadsを使用) ---
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Payments (Stripe, テストモードから開始。本番キーは事業者本人が管理画面で登録) ---
# 未設定時は開発用の疑似トライアル(無課金)で動作する(/billing画面参照)。
# STRIPE_PRICE_ID は Stripeダッシュボードで「月額9,800円」の商品/価格を作成して
# 取得したPrice ID(price_で始まる文字列)。
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID=""
