// Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// DB: Postgres(Neon)。2026-08-27にSQLiteから移行した。旧SQLite用の
// マイグレーション履歴は prisma/migrations_sqlite_archive に記録として残している
// (Postgresへは適用できないSQL方言のため、そのまま使い回すことはできない)。
// Every business table carries companyId for tenant isolation; all queries
// must filter by the authenticated user's companyId (see ARCHITECTURE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
  SITE_MANAGER // 現場責任者(2026-09追記)。担当現場に限定した日報閲覧・出面一次承認を行う
}

// フリーミアム化(2026-08-04追記)。既存会社の動作を変えないため、
// 新規登録の既定値はFREEとし、既存デモ会社はPREMIUMへ移行する(seed参照)。
enum CompanyPlan {
  FREE
  PREMIUM
}

model Company {
  id                        String             @id @default(cuid())
  name                      String
  postalCode                String?
  address                   String?
  phone                     String?
  fax                       String?
  email                     String?
  representativeName        String?
  industry                  String? // 業種(例: 土木、外構、舗装、造成)
  employeeCount             Int? // 従業員数
  closingDay                Int? // 締日(1〜31。月末締めの場合は31を入れる運用とする)
  defaultPaymentTerms       String? // 既定の支払条件(案件個別に上書き可能。例: 月末締め翌月末払い)
  defaultTaxRoundingMode    RoundingMode       @default(ROUND) // 消費税端数処理の既定値
  targetGrossProfitRate     Float? // 目標粗利率(0〜1の割合。例: 0.2 = 20%)。見積の粗利率がこれを下回ると警告表示する
  stripeCustomerId          String?            @unique
  stripeSubscriptionId      String?            @unique
  // Stripeのsubscription.statusをそのまま保存する("trialing" | "active" | "past_due" |
  // "canceled" | "unpaid" | "incomplete" | "incomplete_expired" | null=未契約)。
  // 独自の変換をしないことで、Webhookとの対応関係を単純に保つ。
  subscriptionStatus        String?
  trialEndsAt               DateTime?
  currentPeriodEnd          DateTime?
  cancelAtPeriodEnd         Boolean            @default(false)
  billingEvents             BillingEvent[]
  licenseNumber             String? // 建設業許可番号
  invoiceRegistrationNumber String? // 適格請求書発行事業者登録番号(インボイス制度)
  bankName                  String?
  bankBranch                String?
  bankAccountType           String? // 普通/当座
  bankAccountNumber         String?
  bankAccountHolder         String?
  logoUrl                   String?
  plan                      CompanyPlan        @default(FREE)
  // 運営側(サービス提供者)がこの会社の利用を止めるためのフラグ(Phase9運営管理画面から操作する想定)。
  // ユーザー自身の退会(User.deletedAt)とは別物 — 未払い・規約違反等、運営都合の停止に使う。
  isSuspended               Boolean            @default(false)
  suspendedAt               DateTime?
  suspendedReason           String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  users                     User[]
  customers                 Customer[]
  projects                  Project[]
  quotes                    Quote[]
  contracts                 Contract[]
  invoices                  Invoice[]
  dailyReports              DailyReport[]
  constructionPlans         ConstructionPlan[]
  templates                 Template[]
  auditLogs                 AuditLog[]
  numberSequences           NumberSequence[]
  workItemMasters           WorkItemMaster[]
  employees                 Employee[]
  rateMasterItems           RateMasterItem[]
  kyActivities              KyActivity[]
  projectFiles              ProjectFile[]
  entityFiles               EntityFile[]
  rateMasterPriceHistories  RateMasterPriceHistory[]
  aiExtractions             AiExtraction[]
  // 現場AIの新しい料金プラン(ライト/スタンダード/プロ等)。既存のplan(FREE/PREMIUM)は
  // Stripe連携の契約状態判定にそのまま残し、こちらは表示・請求書用の「どのプランで契約中か」を表す。
  // 既存の契約会社は移行時点ではnullのまま(運営者が会社ごとに割り当てる)。
  pricingPlanId             String?
  pricingPlan               Plan?                    @relation(fields: [pricingPlanId], references: [id])
  notes                     CompanyNote[]
  aiUsageLogs               AiUsageLog[]
  workSettings              CompanyWorkSettings?
  attendances               Attendance[]
  siteAttendances           SiteAttendance[]
  siteExpenseEntries        SiteExpenseEntry[]
  timesheetChangeLogs       TimesheetChangeLog[]
  dailyReportWorkers        DailyReportWorker[]
}

// Stripe Webhookで受け取ったイベントの記録。同一イベントの二重処理を防ぎ(冪等性)、
// 請求履歴の表示にも使う。決済情報そのもの(カード番号等)は保持しない。
model BillingEvent {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stripeEventId String   @unique
  type          String // 例: "checkout.session.completed", "customer.subscription.updated"
  summary       String? // 画面表示用の簡単な説明(例: "月額プラン契約開始")
  createdAt     DateTime @default(now())

  @@index([companyId])
}

enum KyStatus {
  DRAFT // AIによる下書き(未承認)。人間が内容を捏造せず提案しているだけの状態
  CONFIRMED // 現場責任者が内容を確認・承認済み
}

// 危険予知(KY)活動。AIは作業内容から一般的な危険ポイント・対策の候補を提案するのみで、
// 現場責任者による確認・修正・承認を必須とする(依頼元の要件どおり、断定・捏造をしない)。
model KyActivity {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  activityDate    DateTime
  workContent     String // 本日の作業内容(音声入力可)
  itemsJson       String // [{ risk: string, countermeasure: string }] のJSON配列
  status          KyStatus  @default(DRAFT)
  confirmedByName String? // 承認した現場責任者名
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([projectId])
}

// 単価マスタの区分。原価集計(材料費/労務費/重機費/外注費/処分費/その他原価)への
// 割り振りはsrc/lib/rateMaster.tsのcostBucketForCategoryで一元管理する。
enum RateCategory {
  LABOR // 作業員人工
  FOREMAN_LABOR // 世話役人工
  MACHINERY // 重機
  DUMP_TRUCK // ダンプ
  READY_MIX_CONCRETE // 生コン
  CRUSHED_STONE // 砕石
  SOIL_DISPOSAL // 残土処分
  ASPHALT // アスファルト
  CONCRETE_PRODUCT // コンクリート二次製品
  BLOCK // ブロック
  FORMWORK // 型枠
  SUBCONTRACT // 外注
  OVERHEAD // 諸経費
  OTHER
}

// 会社ごとの単価マスタ。AIは単価を勝手に確定させず、ここに登録された単価を
// 優先して見積項目候補に反映する(REQUIREMENTS.md/CLAUDE.mdの原価集計ルール)。
model RateMasterItem {
  id           String                   @id @default(cuid())
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     RateCategory
  name         String // 具体的な品目名(例: "0.25BHバックホウ(日極)")
  unit         String // 単位(例: "日", "m3", "m", "式", "人日")
  unitPrice    Int // 売単価
  costPrice    Int? // 原価(粗利計算用。任意)
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  priceHistory RateMasterPriceHistory[]
  quoteItems   QuoteItem[]
  siteExpenseEntries SiteExpenseEntry[]

  @@index([companyId])
}

// 単価履歴。単価マスタの単価を上書きするのではなく、変更のたびにここへ記録を
// 積み重ねる(REQUIREMENTS.mdの「残土処分 2026/01 8,000円→2026/05 8,500円→…」
// という例と同じ考え方)。過去の見積書から読み取った単価はsourceQuoteId・
// effectiveDate(その見積の作成日)を設定して記録する想定。
model RateMasterPriceHistory {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rateMasterItemId String
  rateMasterItem   RateMasterItem @relation(fields: [rateMasterItemId], references: [id], onDelete: Cascade)
  unitPrice        Int
  costPrice        Int?
  effectiveDate    DateTime       @default(now()) // この単価が有効になった日(過去見積由来ならその見積の作成日)
  sourceQuoteId    String? // どの見積由来かの参照(手動更新の場合はnull)
  sourceQuote      Quote?         @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime       @default(now())

  @@index([companyId])
  @@index([rateMasterItemId])
}

enum EmploymentType {
  REGULAR // 正社員
  PART_TIME // パート・アルバイト
  SUBCONTRACTOR // 一人親方・協力会社
  OTHER
}

// 従業員マスタ。氏名・資格等は機微情報を含み得るため、AI APIへは送信しない
// (REQUIREMENTS.md/SECURITY.mdの個人情報方針を踏襲)。
model Employee {
  id             String                  @id @default(cuid())
  companyId      String
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  nameKana       String? // フリガナ
  position       String? // 役職
  email          String?
  phone          String?
  employmentType EmploymentType          @default(REGULAR)
  hireDate       DateTime? // 入社日
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  qualifications EmployeeQualification[]
  projectMembers ProjectMember[]
  attendances    Attendance[]
  siteAttendances SiteAttendance[]
  dailyReportWorkers DailyReportWorker[]
  // 1人の従業員につき、有効な(退会していない)利用者アカウントは同時に1つまでに限定する。
  // 退会後も過去の勤怠記録からは辿れるよう、DB上のunique制約ではなくアプリ側(User作成/更新時)
  // で検証する(退会済みUserのemployeeIdは残したままにするため)。
  linkedUsers    User[]

  @@index([companyId])
}

// 保有資格。資格ごとに有効期限を持たせ、期限が近いものを一覧・警告できるようにする。
model EmployeeQualification {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String // 資格名(例: 玉掛け技能講習、車両系建設機械)
  expiresAt  DateTime? // 有効期限。期限の定めがない資格はnull
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

// 現場に割り当てられた作業員(Employeeマスタとの中間テーブル)
model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String? // この現場での役割(任意)
  createdAt  DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
}

model User {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email               String              @unique
  // Googleログインのみで作られたアカウントはパスワードを持たないためnull許可。
  // ログイン処理側は必ずnullチェックしてから検証すること(空文字と誤認しない)。
  passwordHash        String?
  googleId            String?             @unique // GoogleのユーザーID(sub)。連携済みの場合のみ設定
  name                String
  role                UserRole            @default(MEMBER)
  // ログイン利用者と従業員マスタ(Employee)の紐付け(2026-09追記)。氏名・メールアドレスでの
  // 突き合わせは事故のもとになるため使わず、必ずこのIDで一意に特定する。同一従業員に対し
  // 有効な(deletedAtがない)Userを複数紐付けないことはアプリ側で検証する(下記コメント参照)。
  employeeId          String?
  employee            Employee?           @relation(fields: [employeeId], references: [id])
  emailVerifiedAt     DateTime? // null=メール未認証。未認証でもログイン自体は妨げない(画面上で案内のみ)
  failedLoginAttempts Int                 @default(0) // ブルートフォース対策。ログイン成功で0に戻す
  lockedUntil         DateTime? // この日時までログイン試行を拒否する
  deletedAt           DateTime? // 退会(論理削除)。物理削除は別途会社単位の完全削除操作で行う
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastLoginAt         DateTime? // 運営管理画面の「最終ログイン」表示に使う
  auditLogs           AuditLog[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  aiUsageLogs         AiUsageLog[]
  supervisedProjects  ProjectSupervisor[]
  createdAttendances  Attendance[]        @relation("AttendanceCreatedBy")
  updatedAttendances  Attendance[]        @relation("AttendanceUpdatedBy")
  approvedAttendances Attendance[]        @relation("AttendanceApprovedBy")
  createdSiteAttendances  SiteAttendance[] @relation("SiteAttendanceCreatedBy")
  updatedSiteAttendances  SiteAttendance[] @relation("SiteAttendanceUpdatedBy")
  approvedSiteAttendances SiteAttendance[] @relation("SiteAttendanceApprovedBy")
  createdSiteExpenseEntries SiteExpenseEntry[]
  timesheetChangeLogs TimesheetChangeLog[]

  @@index([companyId])
  @@index([employeeId])
}

// サービス運営者(杉本本人等)専用のアカウント。会社(Company)には一切紐付かない
// 独立したテーブルにすることで、テナントのUserと混同してA社/B社のデータが
// 見えてしまう事故を構造的に防ぐ(companyIdによる絞り込みが効かない存在を
// テナント側のモデルとは別テーブルにする)。
model PlatformAdmin {
  id           String                 @id @default(cuid())
  email        String                 @unique
  passwordHash String
  name         String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  sessions     PlatformAdminSession[]
  companyNotes CompanyNote[]
}

model PlatformAdminSession {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([adminId])
}

// 運営者が会社の利用停止/再開等、テナントに影響する操作を行った記録。
// 通常のAuditLog(会社ごとの操作ログ)とは別に、運営者側の操作として独立管理する。
model PlatformAdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String // 例: "company.suspend", "company.resume", "company.view"
  companyId String? // 対象会社(閲覧・操作対象)
  createdAt DateTime @default(now())
}

// メール認証・パスワード再設定用の使い捨てトークン。
// 生トークンはメール本文にのみ記載し、DBにはハッシュ値のみ保存する(Session.tokenHashと同じ考え方)。
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String // "EMAIL_VERIFY" | "PASSWORD_RESET"
  expiresAt DateTime
  usedAt    DateTime? // 使用済みトークンの再利用を防ぐ
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ログインセッション。Cookieにはtokenの生値のみを保持し、DBにはハッシュ値のみ保存する
// (DB漏洩時にセッションを乗っ取られないようにするため)。
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  position    String? // 担当者の役職(名刺読み取りで取得)
  department  String? // 担当者の部署名(名刺読み取りで取得)
  postalCode  String?
  phone       String?
  mobilePhone String?
  fax         String?
  email       String?
  websiteUrl  String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@index([companyId])
}

enum ProjectStatus {
  LEAD // 見込み
  ESTIMATING // 見積中
  CONTRACTED // 受注
  IN_PROGRESS // 施工中
  COMPLETED // 完工
  LOST // 失注
}

// 日報を元請提出用に指定様式へ出力する機能(2026-09追記)。新しい元請様式を追加する
// 際は、ここへ値を追加し、対応するxlsx生成処理(src/lib/xlsx/)を追加すること。
enum DailyReportFormat {
  STANDARD // 自社の原価集計表(既存のExcel様式)
  NIPPON_DORO_KOCHO // 日本道路株式会社「工事日報」(共帳022-01)
}

model Project {
  id                         String             @id @default(cuid())
  companyId                  String
  company                    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId                 String
  customer                   Customer           @relation(fields: [customerId], references: [id])
  projectCode                String?            @unique // 工事番号(自動採番、既存データは後方互換のためnull許可)
  name                       String
  siteAddress                String?
  orderingParty              String? // 発注者(自治体等)
  primeContractorName        String? // 元請(自社が下請の場合の元請会社名)
  // 日報を元請提出用の指定様式で作る場合に使う(2026-09追記)。既定は自社の原価集計表様式のまま。
  reportFormat               DailyReportFormat  @default(STANDARD)
  siteAbbreviation           String? // 指定様式の「略称」欄(元請が現場を呼ぶ略称。任意)
  status                     ProjectStatus      @default(LEAD)
  startDate                  DateTime?
  endDate                    DateTime?
  managerName                String? // 自社担当者
  siteAgentName              String? // 現場代理人
  chiefEngineerName          String? // 主任技術者
  contractAmountExcludingTax Int? // 契約金額(税抜、契約前は見積金額の目安として使用)
  taxRatePercent             Int                @default(10)
  paymentTerms               String? // 支払条件(例: 月末締め翌月末払い)
  overview                   String? // 工事概要
  contactName                String? // 発注者側の担当者名(案件依頼AI解析で使用)
  contactPhone               String? // 発注者側の連絡先電話番号(案件依頼AI解析で使用)
  castingDate                DateTime? // 打設日(案件依頼AI解析で使用。無ければ未設定)
  suppliedItems              String? // 支給品(発注者から支給される資材等)
  soilQuantity               String? // 残土数量(例: "10m3"。単位まで含めた表記のまま保持する)
  cautions                   String? // 注意事項
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  quotes                     Quote[]
  contracts                  Contract[]
  invoices                   Invoice[]
  dailyReports               DailyReport[]
  constructionPlans          ConstructionPlan[]
  members                    ProjectMember[]
  kyActivities               KyActivity[]
  files                      ProjectFile[]
  supervisors                ProjectSupervisor[]
  siteAttendances            SiteAttendance[]
  siteExpenseEntries         SiteExpenseEntry[]

  @@index([companyId])
  @@index([customerId])
}

// 現場責任者(User)がどの現場を担当するかの割り当て。ProjectMember(Employeeの現場配属名簿)とは
// 別物 — こちらはログインアカウント(User)に対する「閲覧・一次承認できる範囲」の権限スコープ。
model ProjectSupervisor {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// 現場に紐づく参考資料(過去の見積書・仕様書等)。写真とは別枠で、PDF/Excel/Word等の
// 書類を保存する。DB内BLOB保存はMVP措置であり、大量・大容量になった場合は外部
// ストレージへの切替を検討する(写真と同じ制約、DEPLOYMENT.md参照)。
model ProjectFile {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([projectId])
}

// 顧客・見積・契約書・請求書・従業員の各詳細画面に共通の「ファイル参照」タブ用。
// ProjectFileと同じ用途だが、対象が5種類に及ぶため専用テーブルを5つ作らず、
// entityType+entityIdで対象を判別する1テーブルにまとめる(Prismaは真の多態関連を
// サポートしないため、外部キー制約は張らずアプリ側でcompanyId+entityType+entityIdの
// 組み合わせを必ず検証すること)。従業員の身分証(個人情報)はここでは扱わない
// (身分証は読み取り後に画像を保存しない別の仕組みとする)。
enum FileEntityType {
  CUSTOMER
  QUOTE
  CONTRACT
  INVOICE
  EMPLOYEE
  RATE_MASTER_ITEM
}

model EntityFile {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType FileEntityType
  entityId   String
  fileName   String
  mimeType   String
  data       Bytes
  size       Int
  createdAt  DateTime       @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id])
  estimateNumber   String?     @unique // 見積番号(自動採番、既存データは後方互換のためnull許可)
  title            String
  status           QuoteStatus @default(DRAFT)
  taxRatePercent   Int         @default(10)
  discountAmount   Int         @default(0)
  expirationDate   DateTime? // 見積有効期限
  notes            String?
  duplicatedFromId String? // 複製元見積のID
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            QuoteItem[]
  contracts        Contract[]
  priceHistoryRefs RateMasterPriceHistory[]

  @@index([companyId])
  @@index([projectId])
}

// 単価の出所 — AIが単価を勝手に確定しないための区分(要件定義 REQUIREMENTS.md 参照)
enum PriceSource {
  COMPANY_RATE // 会社登録単価
  PAST_ACTUAL // 過去実績単価
  REFERENCE // 参考単価
  AI_ESTIMATE // AI推定単価(参考値であることを画面上で必ず明示)
  MANUAL // 手動入力単価
}

model QuoteItem {
  id               String          @id @default(cuid())
  quoteId          String
  quote            Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder        Int             @default(0)
  itemName         String
  spec             String? // 規格
  quantity         Float
  unit             String
  unitPrice        Int
  priceSource      PriceSource     @default(MANUAL)
  costPrice        Int? // 原価
  costCategory     RateCategory? // 原価の区分(材料費/労務費/重機費/外注費/処分費/その他原価の集計に使う)
  laborUnits       Float? // 人工
  machinery        String?
  materials        String?
  remarks          String?
  rateMasterItemId String? // 単価マスタのどの品目を参照したか(価格変動アドバイス表示等に使う)
  rateMasterItem   RateMasterItem? @relation(fields: [rateMasterItemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

model DailyReport {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  reportDate       DateTime
  weather          String?
  workerCount      Int?
  workContent      String?
  machinery        String?
  quantityWorked   String?
  safetyNotes      String? // 安全確認
  issues           String?
  nextDayPlan      String?
  rawVoiceInput    String? // 音声認識の元テキスト(監査用)
  // 音声から認識できず、確認が必要な項目。UIでは断定せず「確認候補」として表示する。
  // JSON文字列として [{ field: string, guess: string | null, note: string }] を保持
  unclearItemsJson String?

  // 2026-08-05追記(既存Excel日報の忠実再現+音声入力拡張)。既存データ後方互換のため全て任意。
  foremanName      String? // 職長
  vehicles         String? // 使用車両(machineryとは別枠)
  materials        String? // 使用材料
  subcontractors   String? // 協力会社
  startTime        String? // 開始時間 "HH:mm"
  endTime          String? // 終了時間 "HH:mm"
  breakMinutes     Int? // 休憩時間(分)
  overtimeMinutes  Int? // 残業時間(分)
  dangerPrediction String? // 危険予知
  remarks          String? // 備考
  latitude         Float? // GPS取得時点の緯度
  longitude        Float? // GPS取得時点の経度
  capturedAddress  String? // GPSから逆ジオコーディングした取得時点の現場住所(スナップショット)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       DailyReportPhoto[]
  laborEntries DailyReportLaborEntry[]
  ownItems     DailyReportOwnItem[]
  partnerItems DailyReportPartnerItem[]
  // 勤怠・出面は日報から自動作成されるが、日報を編集・削除しても給与/請求の根拠である
  // これらのレコードは変わらないよう、独立データとして保存する(onDelete: SetNull)。
  attendances        Attendance[]
  siteAttendances    SiteAttendance[]
  siteExpenseEntries SiteExpenseEntry[]
  // 日報ごとの作業員明細(誰が何時間・何人工入ったか)。既存の「作業員数」文字列項目は残しつつ、
  // ここに明細がある場合はここから人数を自動計算する(既存日報の互換性を壊さないため)。
  workers            DailyReportWorker[]
  workTypeEntries    DailyReportWorkTypeEntry[]
  materialEntries    DailyReportMaterialEntry[]
  machineryEntries   DailyReportMachineryEntry[]

  @@index([companyId])
  @@index([projectId])
}

enum PhotoPhase {
  BEFORE // 施工前
  DURING // 施工中
  AFTER // 施工後
  UNKNOWN
}

// 現場写真。クラウドストレージ未契約([no-billing-without-confirmation])のため
// SQLiteのBLOBとしてDB内保存するMVP措置。本番で大量・高解像度の写真を扱う場合は
// 外部ストレージ(S3/R2等、要ユーザー確認・課金)への切替を要する(DEPLOYMENT.md参照)。
model DailyReportPhoto {
  id            String      @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  companyId     String // テナント分離をこのテーブル単体でも効かせるため保持
  data          Bytes
  mimeType      String
  // 施工前/中/後。AI自動判定は課金が発生するため今回は対象外 —
  // 手動選択とし、アップロード順による初期値のみアプリ側で提案する。
  phase         PhotoPhase  @default(UNKNOWN)
  takenAt       DateTime? // EXIFのDateTimeOriginal。取得できなければnull(撮影日時不明)。登録日時はcreatedAt
  caption       String? // ユーザー入力のコメント(AI自動生成は今回スコープ外)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([dailyReportId])
  @@index([companyId])
}

// 原価集計表(既存Excel「日報ひな形」の氏名・単価・残業・職種表に対応)。
// 単価は給与相当の機微情報のため、音声入力の対象にはせず手動入力のみとする。
model DailyReportLaborEntry {
  id            String      @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  workerName    String
  unitPrice     Int? // 単価(日当)
  overtimeHours Float?
  jobType       String? // 職種
  workDescription String? // 作業内容(2026-09追記。元のExcel様式にはない欄だが、誰が何をしたかを
  // 個別に残したいという要望のため追加。原価集計表(Excel)の物理様式は変えないため出力しない)

  @@index([dailyReportId])
}

enum OwnItemKind {
  VEHICLE_MACHINERY // 自社持込車両・機械
  MATERIAL // 自社持込材料
}

// 原価集計表の「自社持込車両・機械」「自社持込材料」表
// (元Excelでは同じ行範囲を左右2列組で共有しているが、DBではkindで区別する)
model DailyReportOwnItem {
  id            String      @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  kind          OwnItemKind
  sortOrder     Int         @default(0)
  name          String
  quantity      String?
  amount        Int?

  @@index([dailyReportId])
}

enum PartnerItemKind {
  PARTNER_EQUIPMENT // 協力会社持込資機材
  OTHER_EXPENSE // その他経費
}

// 原価集計表の「協力会社持込資機材」「その他経費」表
model DailyReportPartnerItem {
  id            String          @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport     @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  kind          PartnerItemKind
  sortOrder     Int             @default(0)
  name          String
  quantity      String?
  unitPrice     Int?

  @@index([dailyReportId])
}

// --- 元請指定様式(日本道路株式会社「工事日報」共帳022-01)向けの明細(2026-09追記) ---
//
// Project.reportFormatがNIPPON_DORO_KOCHOの案件でのみ入力する想定の明細。既存の
// workContent/laborEntries等とは別枠とし、既存の日報機能には一切影響しない。
// 「累計」は元ファイルでは別ファイル参照だったが、既存のcostLedgerXlsx.tsと同じ考え方で
// 同一案件の過去日報分をDBから合計して算出する(累計値そのものは保存しない)。

// 工種・出来高・作業人員・外部提供者(協力会社)の明細。1日報に複数行(工種ごと)持てる。
model DailyReportWorkTypeEntry {
  id                       String      @id @default(cuid())
  dailyReportId            String
  dailyReport              DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  sortOrder                Int         @default(0)
  workType                 String // 工種
  subItem                  String? // 細目
  workArea                 String? // 施工範囲
  unit                     String?
  dailyQuantity            Float? // 出来高(日計)
  dailyWorkerCount         Int? // 作業人員(日計)
  externalProviderName     String? // 外部提供者(協力会社名)
  externalProviderQuantity Float? // 外部提供者への発注数量
  externalProviderUnitPrice Int? // 外部提供者の単価(給与相当の機微情報。手入力のみ)

  @@index([dailyReportId])
}

// 使用材料の明細。
model DailyReportMaterialEntry {
  id                String      @id @default(cuid())
  dailyReportId     String
  dailyReport       DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  sortOrder         Int         @default(0)
  name              String // 品名
  spec              String? // 規格
  unit              String?
  dailyQuantity     Float? // 搬入量(日計)
  inspectionResult  String? // 受入検査("合" | "否" | 空欄)
  supplierName      String? // 外部提供者(仕入先)
  remarks           String?

  @@index([dailyReportId])
}

// 使用機械の明細。元様式は機種ごとに列が固定(バックホウ複数種・ブル・ダンプ・測量機器等)
// だが、会社ごとに保有機械は異なるため、行として自由に追加できる形にする
// (Excel出力時に、指定様式の列位置へ入力順で割り当てる)。
model DailyReportMachineryEntry {
  id                String      @id @default(cuid())
  dailyReportId     String
  dailyReport       DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  sortOrder         Int         @default(0)
  machineType       String // 機種(例: "BH", "ブル", "TR", "TS")
  spec              String? // 規格(例: "0.7", "D30")
  operatorName      String? // 運転手
  dailyCount        Float? // 使用台数・時間等(日計)

  @@index([dailyReportId])
}

// 作業内容マスタ(よく使う作業内容の候補。日報の作業内容欄で候補表示に使う)
model WorkItemMaster {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

enum PlanSectionStatus {
  NEEDS_INPUT // 情報不足で未着手
  DRAFTED // AIが下書きを作成した(未確認)
  NEEDS_CONFIRMATION // 推測を含む・要人間確認
  CONFIRMED // 人間が確認済み
}

model ConstructionPlan {
  id                String                    @id @default(cuid())
  companyId         String
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project                   @relation(fields: [projectId], references: [id])
  templateId        String? // 発注者/自治体別テンプレート
  template          Template?                 @relation(fields: [templateId], references: [id])
  agentName         String? // 現場代理人(後から入力可)
  supervisorName    String? // 主任技術者(後から入力可)
  isSubmissionReady Boolean                   @default(false) // 人間が最終確認するまでfalse
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  sections          ConstructionPlanSection[]

  @@index([companyId])
  @@index([projectId])
}

// 施工計画書の各章(工事概要/施工方針/安全管理...) REQUIREMENTS.md #6 の必須仕様に対応:
// 不足情報の明示・推測箇所の明示・元資料との対応・断定しない、をsection単位で保持する。
model ConstructionPlanSection {
  id               String            @id @default(cuid())
  planId           String
  plan             ConstructionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  sectionKey       String // 例: "工事概要", "施工方針", "安全管理" 等の固定キー
  title            String
  sortOrder        Int               @default(0)
  content          String?
  status           PlanSectionStatus @default(NEEDS_INPUT)
  missingInfoJson  String? // 不足情報のリスト(JSON配列)
  assumedItemsJson String? // 推測で埋めた箇所の明示(JSON配列)
  sourceRefsJson   String? // 元資料(ページ/ファイル名等)との対応(JSON配列)

  @@index([planId])
}

enum TemplateKind {
  QUOTE
  CONSTRUCTION_PLAN
  DAILY_REPORT
}

// 会社別・発注者別のテンプレート(価格表示のひな形、施工計画書の章立てなど)
model Template {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind              TemplateKind
  name              String
  configJson        String // テンプレートごとの設定(章立て・既定文言等)をJSONで保持
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  constructionPlans ConstructionPlan[]

  @@index([companyId])
}

// 操作ログ・アクセスログ(SECURITY.md要件)。個人情報・口座情報・顧客情報の本文は記録しない。
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // 例: "quote.create", "auth.login", "customer.delete"
  targetType String?
  targetId   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

// 契約書・見積書・請求書の自動採番(会社×書類種別×年度で連番)。
// 同時操作でも番号が重複しないよう、採番時は必ずトランザクション内でupdate/createする(src/lib/numbering.ts)。
model NumberSequence {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docType    String // "PROJECT" | "ESTIMATE" | "CONTRACT" | "INVOICE"
  year       Int
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, docType, year])
}

// 消費税額の端数処理方法(REQUIREMENTS.md/税務処理要件)
enum RoundingMode {
  FLOOR // 切り捨て
  ROUND // 四捨五入
  CEIL // 切り上げ
}

enum ContractStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// 工事請負契約書。案件・見積情報から自動反映して作成する(REQUIREMENTS.md #9)。
// 法的有効性を保証するものではなく一般的なひな形である旨を画面上に必ず表示する。
// confirm(契約確定)時にconfirmedSnapshotJsonへ内容を保存し、以後projectやquoteが
// 変更されても確定済み契約書の内容は変わらないようにする。
model Contract {
  id                         String         @id @default(cuid())
  companyId                  String
  company                    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId                  String
  project                    Project        @relation(fields: [projectId], references: [id])
  quoteId                    String? // 参照元見積(任意)
  quote                      Quote?         @relation(fields: [quoteId], references: [id])
  contractNumber             String         @unique
  contractDate               DateTime
  contractAmountExcludingTax Int
  taxRatePercent             Int            @default(10)
  taxAmount                  Int
  contractAmountIncludingTax Int
  roundingMode               RoundingMode   @default(ROUND)
  startDate                  DateTime?
  endDate                    DateTime?
  paymentTerms               String?
  warrantyTerms              String? // 瑕疵・契約不適合対応
  delayTerms                 String? // 工期変更・遅延時の対応
  cancellationTerms          String? // 契約解除条件
  specialTerms               String? // 特約事項
  clausesJson                String // 基本条項本文(JSON配列、章ごとに編集可能)
  status                     ContractStatus @default(DRAFT)
  version                    Int            @default(1)
  confirmedSnapshotJson      String? // 確定時点のスナップショット(JSON)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  invoices                   Invoice[]

  @@index([companyId])
  @@index([projectId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum BillingType {
  FULL // 全額請求
  DEPOSIT // 着手金
  PROGRESS // 中間金/出来高請求
  PARTIAL // 一部請求
  FINAL // 完成時請求
}

// 請求書。契約書・案件情報から作成する(REQUIREMENTS.md #10)。
// 累計請求額が契約金額を超える場合は保存できないようにサーバー側で必ず検証する(src/lib/invoiceCalc.ts)。
// issue(発行)時にissuedSnapshotJsonへ内容を保存し、以後の変更を防ぐ。
model Invoice {
  id                     String        @id @default(cuid())
  companyId              String
  company                Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId              String
  project                Project       @relation(fields: [projectId], references: [id])
  contractId             String?
  contract               Contract?     @relation(fields: [contractId], references: [id])
  invoiceNumber          String        @unique
  issueDate              DateTime
  dueDate                DateTime?
  billingType            BillingType   @default(FULL)
  billingPercentage      Float?
  previousBilledAmount   Int           @default(0)
  currentBilledAmount    Int           @default(0)
  cumulativeBilledAmount Int           @default(0)
  remainingAmount        Int           @default(0)
  subtotal               Int           @default(0)
  taxRatePercent         Int           @default(10)
  taxAmount              Int           @default(0)
  total                  Int           @default(0)
  roundingMode           RoundingMode  @default(ROUND)
  status                 InvoiceStatus @default(DRAFT)
  paidAt                 DateTime? // 入金確認日時(手動で「入金確認」操作した時点)
  notes                  String?
  issuedSnapshotJson     String? // 発行時点のスナップショット(JSON)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  items                  InvoiceItem[]

  @@index([companyId])
  @@index([projectId])
  @@index([contractId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  itemName  String
  spec      String?
  quantity  Float
  unit      String
  unitPrice Int
  remarks   String?

  @@index([invoiceId])
}

// --- AIかんたん登録(2026-08-29追記) -----------------------------------------
//
// ダッシュボードの「AIかんたん登録」で撮影・添付・貼り付け・音声した内容を、
// 種類判定→抽出した直後にDBへ確定保存せず、一度ここへ一時保存する
// (ai_inbox)。ユーザーが確認画面で内容を見て「この内容で登録」を押した
// 時点で初めて顧客・案件等の本体テーブルへ書き込む(AIが勝手に確定しない
// という一貫した方針を、複数エンティティにまたがる登録でも維持するため)。
enum AiDocumentType {
  BUSINESS_CARD
  ESTIMATE_REQUEST
  ESTIMATE
  CONTRACT
  INVOICE
  EMPLOYEE_ID
  PROJECT_MESSAGE
  UNKNOWN
}

enum AiExtractionStatus {
  PROCESSING
  REVIEW_REQUIRED
  APPROVED
  REJECTED
  FAILED
}

model AiExtraction {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUserId String
  documentType    AiDocumentType
  status          AiExtractionStatus @default(REVIEW_REQUIRED)
  sourceSummary   String? // 何を読み取ったか(ファイル名・音声の冒頭等)の簡単な表示用メモ
  extractedJson   String // 顧客/案件/従業員の抽出候補・重複候補・確信度をまとめたJSON
  errorMessage    String? // 解析に失敗した場合の理由(画面表示用)
  resultCustomerId String?
  resultProjectId  String?
  resultEmployeeId String?
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?

  @@index([companyId])
  @@index([companyId, status])
}

// ここから「マネタイズ機能(AIツール販売・商品管理・契約プラン)」関連のモデル。
// 既存の業務モデル(顧客・案件・見積等)とは独立しており、運営者(PlatformAdmin)が
// 商品・プランを管理し、契約会社(Company)に割り当てる形で使う。

// 現場AI自体の料金プラン(例: ライト/スタンダード/プロ)。金額をコードに直書きせず、
// 運営者が管理画面(/admin/plans)から追加・変更できるようにするためのマスタ。
// 既存のCompany.plan(FREE/PREMIUM)はStripe Webhookの契約状態判定にそのまま使うため残す。
// このPlanは「今どの段階の商品を、いくらで売っているか」の一覧・請求書表示用の情報。
model Plan {
  id             String    @id @default(cuid())
  key            String    @unique // コードから安定して参照するためのキー(例: "light")
  name           String // 表示名(例: ライト)
  monthlyPrice   Int // 月額(円、税抜)
  setupFee       Int       @default(0) // 初期費用(円、税抜)
  description    String?
  // 以下は将来の使用量上限機能(Phase2)のために先に用意しておく列。
  // 現時点ではどの画面からも参照・強制していない(表示専用)。
  aiRunLimit     Int? // 月あたりのAI実行回数上限(nullは無制限)
  storageLimitMb Int?
  userLimit      Int?
  isActive       Boolean   @default(true) // falseにすると新規契約の選択肢から外れる(既存契約者には影響しない)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  companies      Company[]
}

enum ProductSalesStatus {
  DRAFT // 準備中(まだ販売しない)
  ON_SALE // 販売中
  DISCONTINUED // 販売終了
}

// 販売用の「AI業務改善ツール」商品カタログ(AI見積作成/AI写真帳作成 等を商品として売るための一覧)。
// 導入会社数・売上・原価・利益は、どの契約会社がどの商品を使っているかを結びつける仕組み
// (Phase2以降)ができてから正しい値を出せるため、今回は列を作らない
// (根拠のない数字を表示しない、というCLAUDE.mdの方針に沿う)。
model Product {
  id             String             @id @default(cuid())
  name           String
  description    String?
  targetCustomer String? // 対象顧客(例: 従業員10名以下の土木会社)
  price          Int? // 買い切り価格(円、税抜)。月額商品の場合は空でよい
  monthlyPrice   Int? // 月額価格(円、税抜)
  setupFee       Int? // 初期費用(円、税抜)
  featuresText   String? // 機能・できることの説明(箇条書きテキスト)
  salesStatus    ProductSalesStatus @default(DRAFT)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

enum CompanyNoteType {
  MEETING // 商談履歴
  INQUIRY // 問い合わせ履歴
}

// 契約会社(見込み客含む)に対する商談・問い合わせの記録。運営者(PlatformAdmin)が
// 会社詳細画面から追記する営業メモ。テナント企業自身には見せない(運営者専用データ)。
model CompanyNote {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type             CompanyNoteType
  content          String
  createdByAdminId String?
  createdByAdmin   PlatformAdmin?  @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([companyId])
}

// AI(Anthropic API)呼び出し1回ごとの利用実績。会社別のAI利用回数・トークン数・
// 成否を記録し、将来の料金プラン設計・原価分析(AIコスト管理)の元データにする。
// AI_API_KEY未設定(モック動作)の場合もmodel="mock"として記録し、「AI機能を
// 何回使ったか」という利用回数自体は追える形にする(コストはmockの場合0円)。
model AiUsageLog {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String // 例: "quote.draft", "dailyReport.draft", "businessCard.scan"
  model        String // 例: "claude-haiku-4-5-20251001" または "mock"
  inputTokens  Int?
  outputTokens Int?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([userId])
}

// --- 勤怠・出面管理(2026-09追記) ---------------------------------------------
//
// 日報から勤怠(給与計算の根拠)と出面(元請請求・現場原価の根拠)を自動作成するが、
// 日報が後から編集・削除されても給与/請求の根拠は変わってはならないため、
// DB上は日報から独立したデータとして保存する(sourceDailyReportIdはonDelete: SetNull、
// 日報が消えても勤怠・出面のレコード自体は残る)。
// 元請は既存Project.primeContractorName(自由入力)をそのまま使い、新規の元請マスタは作らない
// (実装前確認Q1の回答どおり)。従業員は自社の従業員マスタ(Employee)から選ぶことを基本としつつ、
// マスタに登録のない協力会社等はworkerNameへの直接入力で代替する(実装前確認Q2の回答どおり)。

enum TimeRoundingUnit {
  NONE
  ROUND_5MIN
  ROUND_10MIN
  ROUND_15MIN
  ROUND_30MIN
}

enum OvertimeCalcMethod {
  DAILY_EIGHT_HOURS // 1日8時間(法定労働時間)を超えた分を残業とする
  SCHEDULED_HOURS // 会社の所定労働時間を超えた分を残業とする
}

// 会社ごとの勤務設定。計算ルールをコードへ固定せず、ここから調整できるようにする。
model CompanyWorkSettings {
  id                                  String             @id @default(cuid())
  companyId                           String             @unique
  company                             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scheduledStartTime                  String             @default("08:00") // "HH:mm"
  scheduledEndTime                    String             @default("17:00")
  scheduledBreakMinutes               Int                @default(120)
  scheduledWorkMinutes                Int                @default(480) // 1日の所定労働時間(分)
  closingDay                          Int                @default(31) // 締日(1〜31。31=月末)
  holidayWeekdaysJson                 String             @default("[0]") // 休日の曜日。0=日曜〜6=土曜のJSON配列
  overtimeCalcMethod                  OvertimeCalcMethod @default(DAILY_EIGHT_HOURS)
  nightShiftStartTime                 String             @default("22:00")
  nightShiftEndTime                   String             @default("05:00")
  timeRounding                        TimeRoundingUnit   @default(NONE)
  amountRoundingMode                  RoundingMode       @default(ROUND)
  maxManDaysPerDay                    Float? // 1人1日あたりの人工数上限(警告用。任意)
  autoCreateAttendanceFromDailyReport Boolean            @default(true)
  attendanceApprovalRequired          Boolean            @default(true)
  siteAttendanceApprovalRequired      Boolean            @default(true)
  createdAt                           DateTime           @default(now())
  updatedAt                           DateTime           @updatedAt
}

enum WorkCategory {
  NORMAL // 通常勤務
  HOLIDAY_WORK // 休日出勤
  PAID_LEAVE // 有給
  HALF_DAY_LEAVE // 半休
  ABSENCE // 欠勤
  LATE // 遅刻
  EARLY_LEAVE // 早退
}

enum TimesheetStatus {
  DRAFT // 下書き
  SUBMITTED // 提出済み
  APPROVED // 承認済み
  REJECTED // 差し戻し
  CLOSED // 締め済み
}

// 勤怠(給与計算の根拠)。1従業員・1日につき1件(複数現場に入った場合も出面側で分けて記録し、
// 勤怠は合算した1日分として扱う)。
model Attendance {
  id                  String           @id @default(cuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id])
  targetDate          DateTime
  clockInTime         DateTime?
  clockOutTime        DateTime?
  siteArrivalTime     DateTime?
  siteDepartureTime   DateTime?
  breakMinutes        Int              @default(0)
  actualWorkMinutes   Int? // 実働時間
  normalWorkMinutes   Int? // 普通勤務時間
  overtimeMinutes     Int? // 残業時間
  nightShiftMinutes   Int? // 深夜勤務時間
  holidayWorkMinutes  Int? // 休日勤務時間
  workCategory        WorkCategory     @default(NORMAL)
  isPaidLeave         Boolean          @default(false)
  isAbsence           Boolean          @default(false)
  isLate              Boolean          @default(false)
  isEarlyLeave        Boolean          @default(false)
  remarks             String?
  sourceDailyReportId String?
  sourceDailyReport   DailyReport?     @relation(fields: [sourceDailyReportId], references: [id], onDelete: SetNull)
  status              TimesheetStatus  @default(DRAFT)
  submittedAt         DateTime?
  approvedByUserId    String?
  approvedByUser      User?            @relation("AttendanceApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt          DateTime?
  rejectionReason     String?
  closedAt            DateTime?
  closedByUserId      String?
  reopenedAt          DateTime?
  reopenReason         String?
  createdByUserId     String
  createdByUser       User             @relation("AttendanceCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId     String?
  updatedByUser       User?            @relation("AttendanceUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  // 1つの勤怠(従業員×日付)に対し、複数の日報の作業員明細が反映されることがある
  // (同じ人が同じ日に複数現場の日報へ登場した場合、勤怠としては1日分に合算されるため)。
  dailyReportWorkers  DailyReportWorker[]

  @@unique([employeeId, targetDate])
  @@index([companyId])
  @@index([companyId, targetDate])
  @@index([employeeId])
}

enum ManDayUnit {
  QUARTER // 0.25人工
  HALF // 0.5人工
  THREE_QUARTER // 0.75人工
  FULL // 1人工
  CUSTOM // 任意入力
}

// 出面(元請への請求・現場原価の根拠)。1人が1日に複数現場へ入れるよう、
// 従業員×日付の組み合わせに一意制約はかけない(重複はアプリ側で検知し警告する)。
model SiteAttendance {
  id                  String           @id @default(cuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetDate          DateTime
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id])
  sourceDailyReportId String?
  sourceDailyReport   DailyReport?     @relation(fields: [sourceDailyReportId], references: [id], onDelete: SetNull)
  employeeId          String?
  employee            Employee?        @relation(fields: [employeeId], references: [id])
  // 従業員マスタに登録のない協力会社等はここへ直接入力する(employeeId設定時はEmployee.nameの
  // スナップショットとして保持し、後から従業員名が変わっても当時の記録を変えない)。
  workerName          String
  jobType             String? // 職種
  workContent         String?
  startTime           DateTime?
  endTime             DateTime?
  breakMinutes        Int              @default(0)
  workMinutes         Int?
  manDayUnit          ManDayUnit       @default(FULL)
  manDays             Float // 実際の人工数(0.25刻み、または任意入力の値)
  manDayUnitPrice     Int? // 人工単価(従業員には非表示、権限管理で制御)
  amount              Int? // 人工金額 = manDays × manDayUnitPrice
  isBillable          Boolean          @default(true) // 請求対象
  isCostTarget        Boolean          @default(true) // 原価対象
  remarks             String?
  status              TimesheetStatus  @default(DRAFT)
  submittedAt         DateTime?
  approvedByUserId    String?
  approvedByUser      User?            @relation("SiteAttendanceApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt          DateTime?
  rejectionReason     String?
  closedAt            DateTime?
  createdByUserId     String
  createdByUser       User             @relation("SiteAttendanceCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId     String?
  updatedByUser       User?            @relation("SiteAttendanceUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  // 出面1件は必ず1つの日報作業員明細から作られる(こちらは1:1)。
  dailyReportWorker   DailyReportWorker?

  @@index([companyId])
  @@index([companyId, targetDate])
  @@index([projectId])
  @@index([employeeId])
}

enum SiteExpenseCategory {
  VEHICLE // 車両
  MACHINERY // 重機
  MATERIAL // 材料
  TRANSPORT // 回送
  TRAVEL_EXPENSE // 交通費
  OTHER
}

// 出面に関連する車両・重機・経費の明細。現場・日付単位(複数の作業員で共有するため、
// SiteAttendance1件ずつではなくProject×日付に紐づける)。
model SiteExpenseEntry {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetDate          DateTime
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id])
  sourceDailyReportId String?
  sourceDailyReport   DailyReport?        @relation(fields: [sourceDailyReportId], references: [id], onDelete: SetNull)
  rateMasterItemId    String? // 単価マスタ参照(任意。既存のRateMasterItemを流用し、新規マスタは作らない)
  rateMasterItem      RateMasterItem?     @relation(fields: [rateMasterItemId], references: [id], onDelete: SetNull)
  category            SiteExpenseCategory
  name                String
  quantity            Float               @default(1) // 台数・常用数量
  usageHours          Float? // 使用時間
  unit                String?
  unitPrice           Int?
  amount              Int?
  dispatchFee         Int? // 回送費
  tollFee             Int? // 高速代
  parkingFee          Int? // 駐車場代
  otherFee            Int?
  isBillable          Boolean             @default(true)
  isCostTarget        Boolean             @default(true)
  remarks             String?
  status              TimesheetStatus     @default(DRAFT)
  createdByUserId     String
  createdByUser       User                @relation(fields: [createdByUserId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([companyId])
  @@index([companyId, targetDate])
  @@index([projectId])
}

enum TimesheetEntityType {
  ATTENDANCE
  SITE_ATTENDANCE
}

enum TimesheetChangeType {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  CLOSE
  REOPEN
}

// 勤怠・出面の変更履歴。給与・請求に関わるため、AuditLog(操作ログ全般)とは別に
// 変更前後の値そのものを記録する(1テーブルにまとめ、種類はentityTypeで区別する。
// 対象ごとに似たテーブルを複数作らない)。
model TimesheetChangeLog {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType      TimesheetEntityType
  entityId        String
  changeType      TimesheetChangeType
  beforeJson      String?
  afterJson       String?
  reason          String? // 差し戻し理由・締め解除理由等
  changedByUserId String
  changedByUser   User                @relation(fields: [changedByUserId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
}

enum DailyReportWorkerType {
  EMPLOYEE // 自社従業員
  PARTNER // 協力会社
  SUBCONTRACTOR // 外注
  MANUAL // 手入力作業員(マスタ未登録)
}

// 日報ごとの作業員明細。既存の日報にあった「作業員数(人数のみ)」「職長(氏名のみ)」を
// 置き換えるのではなく、明細を追加してそこから人数を自動計算する形にする(過去日報を
// 変更しない・既存表示を壊さないため。明細がない過去日報は従来どおりworkerCount/
// foremanNameの表示のままにする)。
// 日報を編集している間はこの明細を直接書き換えられるが、いったんAttendance/SiteAttendance
// へ反映(reflectToAttendance/reflectToSiteAttendanceがtrueの状態で保存)された後は、
// 反映先が承認済み(APPROVED)・締め済み(CLOSED)の場合は自動上書きせず、
// 「再反映が必要な候補」として画面上で示す(サーバー側の反映処理で判定する)。
model DailyReportWorker {
  id                String                @id @default(cuid())
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dailyReportId     String
  dailyReport       DailyReport           @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  employeeId        String?
  employee          Employee?             @relation(fields: [employeeId], references: [id])
  // 従業員マスタ未登録(協力会社・外注・手入力)の場合の表示名。employeeId設定時はEmployee.nameの
  // スナップショット(後から従業員名が変わっても当時の記録を変えない)。
  workerName        String
  workerType        DailyReportWorkerType @default(EMPLOYEE)
  role              String? // 職種・役割(現場での職種。従業員マスタのposition=会社上の役職とは別)
  startTime         String? // "HH:mm"。未入力なら日報全体の開始時間を初期値として使う
  endTime           String?
  breakMinutes      Int?
  workMinutes       Int?
  overtimeMinutes   Int?
  manDays           Float?
  workDescription   String?
  isBillable        Boolean               @default(true)
  isForeman         Boolean               @default(false) // 職長。1日報につき1人までをアプリ側で担保する
  reflectToAttendance     Boolean         @default(true) // 勤怠へ反映するか
  reflectToSiteAttendance Boolean         @default(true) // 出面へ反映するか
  // 反映済みのAttendance/SiteAttendanceへのリンク(反映状況・承認状態の表示に使う)。
  // Attendanceは従業員×日付で1件のため、同じ人が同日複数現場に入ると複数のDailyReportWorkerが
  // 同じAttendanceを指すことがある(そのため一意制約はつけない)。SiteAttendanceは1明細=1件。
  attendanceId      String?
  attendance        Attendance?           @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  siteAttendanceId  String?               @unique
  siteAttendance    SiteAttendance?       @relation(fields: [siteAttendanceId], references: [id], onDelete: SetNull)
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([companyId])
  @@index([dailyReportId])
  @@index([employeeId])
  @@index([attendanceId])
}
