// Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Dev DB: SQLite (file:./dev.db). Production should point DATABASE_URL at a
// hosted Postgres (Neon/Supabase等) — see ENVIRONMENT_VARIABLES.md.
// Every business table carries companyId for tenant isolation; all queries
// must filter by the authenticated user's companyId (see ARCHITECTURE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  MEMBER
}

// フリーミアム化(2026-08-04追記)。既存会社の動作を変えないため、
// 新規登録の既定値はFREEとし、既存デモ会社はPREMIUMへ移行する(seed参照)。
enum CompanyPlan {
  FREE
  PREMIUM
}

model Company {
  id                        String             @id @default(cuid())
  name                      String
  postalCode                String?
  address                   String?
  phone                     String?
  fax                       String?
  email                     String?
  representativeName        String?
  industry                  String? // 業種(例: 土木、外構、舗装、造成)
  employeeCount             Int? // 従業員数
  closingDay                Int? // 締日(1〜31。月末締めの場合は31を入れる運用とする)
  defaultPaymentTerms       String? // 既定の支払条件(案件個別に上書き可能。例: 月末締め翌月末払い)
  defaultTaxRoundingMode    RoundingMode       @default(ROUND) // 消費税端数処理の既定値
  targetGrossProfitRate     Float? // 目標粗利率(0〜1の割合。例: 0.2 = 20%)。見積の粗利率がこれを下回ると警告表示する
  licenseNumber             String? // 建設業許可番号
  invoiceRegistrationNumber String? // 適格請求書発行事業者登録番号(インボイス制度)
  bankName                  String?
  bankBranch                String?
  bankAccountType           String? // 普通/当座
  bankAccountNumber         String?
  bankAccountHolder         String?
  logoUrl                   String?
  plan                      CompanyPlan        @default(FREE)
  // 運営側(サービス提供者)がこの会社の利用を止めるためのフラグ(Phase9運営管理画面から操作する想定)。
  // ユーザー自身の退会(User.deletedAt)とは別物 — 未払い・規約違反等、運営都合の停止に使う。
  isSuspended               Boolean            @default(false)
  suspendedAt               DateTime?
  suspendedReason           String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  users                     User[]
  customers                 Customer[]
  projects                  Project[]
  quotes                    Quote[]
  contracts                 Contract[]
  invoices                  Invoice[]
  dailyReports              DailyReport[]
  constructionPlans         ConstructionPlan[]
  templates                 Template[]
  auditLogs                 AuditLog[]
  numberSequences           NumberSequence[]
  workItemMasters           WorkItemMaster[]
  employees                 Employee[]
  rateMasterItems           RateMasterItem[]
  kyActivities              KyActivity[]
}

enum KyStatus {
  DRAFT // AIによる下書き(未承認)。人間が内容を捏造せず提案しているだけの状態
  CONFIRMED // 現場責任者が内容を確認・承認済み
}

// 危険予知(KY)活動。AIは作業内容から一般的な危険ポイント・対策の候補を提案するのみで、
// 現場責任者による確認・修正・承認を必須とする(依頼元の要件どおり、断定・捏造をしない)。
model KyActivity {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  activityDate    DateTime
  workContent     String // 本日の作業内容(音声入力可)
  itemsJson       String // [{ risk: string, countermeasure: string }] のJSON配列
  status          KyStatus  @default(DRAFT)
  confirmedByName String? // 承認した現場責任者名
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([projectId])
}

// 単価マスタの区分。原価集計(材料費/労務費/重機費/外注費/処分費/その他原価)への
// 割り振りはsrc/lib/rateMaster.tsのcostBucketForCategoryで一元管理する。
enum RateCategory {
  LABOR // 作業員人工
  FOREMAN_LABOR // 世話役人工
  MACHINERY // 重機
  DUMP_TRUCK // ダンプ
  READY_MIX_CONCRETE // 生コン
  CRUSHED_STONE // 砕石
  SOIL_DISPOSAL // 残土処分
  ASPHALT // アスファルト
  CONCRETE_PRODUCT // コンクリート二次製品
  BLOCK // ブロック
  FORMWORK // 型枠
  SUBCONTRACT // 外注
  OVERHEAD // 諸経費
  OTHER
}

// 会社ごとの単価マスタ。AIは単価を勝手に確定させず、ここに登録された単価を
// 優先して見積項目候補に反映する(REQUIREMENTS.md/CLAUDE.mdの原価集計ルール)。
model RateMasterItem {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  RateCategory
  name      String // 具体的な品目名(例: "0.25BHバックホウ(日極)")
  unit      String // 単位(例: "日", "m3", "m", "式", "人日")
  unitPrice Int // 売単価
  costPrice Int? // 原価(粗利計算用。任意)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([companyId])
}

enum EmploymentType {
  REGULAR // 正社員
  PART_TIME // パート・アルバイト
  SUBCONTRACTOR // 一人親方・協力会社
  OTHER
}

// 従業員マスタ。氏名・資格等は機微情報を含み得るため、AI APIへは送信しない
// (REQUIREMENTS.md/SECURITY.mdの個人情報方針を踏襲)。
model Employee {
  id             String                  @id @default(cuid())
  companyId      String
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  nameKana       String? // フリガナ
  position       String? // 役職
  email          String?
  phone          String?
  employmentType EmploymentType          @default(REGULAR)
  hireDate       DateTime? // 入社日
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  qualifications EmployeeQualification[]
  projectMembers ProjectMember[]

  @@index([companyId])
}

// 保有資格。資格ごとに有効期限を持たせ、期限が近いものを一覧・警告できるようにする。
model EmployeeQualification {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String // 資格名(例: 玉掛け技能講習、車両系建設機械)
  expiresAt  DateTime? // 有効期限。期限の定めがない資格はnull
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

// 現場に割り当てられた作業員(Employeeマスタとの中間テーブル)
model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String? // この現場での役割(任意)
  createdAt  DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
}

model User {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email               String              @unique
  passwordHash        String
  name                String
  role                UserRole            @default(MEMBER)
  emailVerifiedAt     DateTime? // null=メール未認証。未認証でもログイン自体は妨げない(画面上で案内のみ)
  failedLoginAttempts Int                 @default(0) // ブルートフォース対策。ログイン成功で0に戻す
  lockedUntil         DateTime? // この日時までログイン試行を拒否する
  deletedAt           DateTime? // 退会(論理削除)。物理削除は別途会社単位の完全削除操作で行う
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastLoginAt         DateTime? // 運営管理画面の「最終ログイン」表示に使う
  auditLogs           AuditLog[]
  sessions            Session[]
  verificationTokens  VerificationToken[]

  @@index([companyId])
}

// サービス運営者(杉本本人等)専用のアカウント。会社(Company)には一切紐付かない
// 独立したテーブルにすることで、テナントのUserと混同してA社/B社のデータが
// 見えてしまう事故を構造的に防ぐ(companyIdによる絞り込みが効かない存在を
// テナント側のモデルとは別テーブルにする)。
model PlatformAdmin {
  id           String                 @id @default(cuid())
  email        String                 @unique
  passwordHash String
  name         String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  sessions     PlatformAdminSession[]
}

model PlatformAdminSession {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([adminId])
}

// 運営者が会社の利用停止/再開等、テナントに影響する操作を行った記録。
// 通常のAuditLog(会社ごとの操作ログ)とは別に、運営者側の操作として独立管理する。
model PlatformAdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String // 例: "company.suspend", "company.resume", "company.view"
  companyId String? // 対象会社(閲覧・操作対象)
  createdAt DateTime @default(now())
}

// メール認証・パスワード再設定用の使い捨てトークン。
// 生トークンはメール本文にのみ記載し、DBにはハッシュ値のみ保存する(Session.tokenHashと同じ考え方)。
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String // "EMAIL_VERIFY" | "PASSWORD_RESET"
  expiresAt DateTime
  usedAt    DateTime? // 使用済みトークンの再利用を防ぐ
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ログインセッション。Cookieにはtokenの生値のみを保持し、DBにはハッシュ値のみ保存する
// (DB漏洩時にセッションを乗っ取られないようにするため)。
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@index([companyId])
}

enum ProjectStatus {
  LEAD // 見込み
  ESTIMATING // 見積中
  CONTRACTED // 受注
  IN_PROGRESS // 施工中
  COMPLETED // 完工
  LOST // 失注
}

model Project {
  id                         String             @id @default(cuid())
  companyId                  String
  company                    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId                 String
  customer                   Customer           @relation(fields: [customerId], references: [id])
  projectCode                String?            @unique // 工事番号(自動採番、既存データは後方互換のためnull許可)
  name                       String
  siteAddress                String?
  orderingParty              String? // 発注者(自治体等)
  primeContractorName        String? // 元請(自社が下請の場合の元請会社名)
  status                     ProjectStatus      @default(LEAD)
  startDate                  DateTime?
  endDate                    DateTime?
  managerName                String? // 自社担当者
  siteAgentName              String? // 現場代理人
  chiefEngineerName          String? // 主任技術者
  contractAmountExcludingTax Int? // 契約金額(税抜、契約前は見積金額の目安として使用)
  taxRatePercent             Int                @default(10)
  paymentTerms               String? // 支払条件(例: 月末締め翌月末払い)
  overview                   String? // 工事概要
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  quotes                     Quote[]
  contracts                  Contract[]
  invoices                   Invoice[]
  dailyReports               DailyReport[]
  constructionPlans          ConstructionPlan[]
  members                    ProjectMember[]
  kyActivities               KyActivity[]

  @@index([companyId])
  @@index([customerId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id])
  estimateNumber   String?     @unique // 見積番号(自動採番、既存データは後方互換のためnull許可)
  title            String
  status           QuoteStatus @default(DRAFT)
  taxRatePercent   Int         @default(10)
  discountAmount   Int         @default(0)
  expirationDate   DateTime? // 見積有効期限
  notes            String?
  duplicatedFromId String? // 複製元見積のID
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            QuoteItem[]
  contracts        Contract[]

  @@index([companyId])
  @@index([projectId])
}

// 単価の出所 — AIが単価を勝手に確定しないための区分(要件定義 REQUIREMENTS.md 参照)
enum PriceSource {
  COMPANY_RATE // 会社登録単価
  PAST_ACTUAL // 過去実績単価
  REFERENCE // 参考単価
  AI_ESTIMATE // AI推定単価(参考値であることを画面上で必ず明示)
  MANUAL // 手動入力単価
}

model QuoteItem {
  id           String        @id @default(cuid())
  quoteId      String
  quote        Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder    Int           @default(0)
  itemName     String
  spec         String? // 規格
  quantity     Float
  unit         String
  unitPrice    Int
  priceSource  PriceSource   @default(MANUAL)
  costPrice    Int? // 原価
  costCategory RateCategory? // 原価の区分(材料費/労務費/重機費/外注費/処分費/その他原価の集計に使う)
  laborUnits   Float? // 人工
  machinery    String?
  materials    String?
  remarks      String?

  @@index([quoteId])
}

model DailyReport {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  reportDate       DateTime
  weather          String?
  workerCount      Int?
  workContent      String?
  machinery        String?
  quantityWorked   String?
  safetyNotes      String? // 安全確認
  issues           String?
  nextDayPlan      String?
  rawVoiceInput    String? // 音声認識の元テキスト(監査用)
  // 音声から認識できず、確認が必要な項目。UIでは断定せず「確認候補」として表示する。
  // JSON文字列として [{ field: string, guess: string | null, note: string }] を保持
  unclearItemsJson String?

  // 2026-08-05追記(既存Excel日報の忠実再現+音声入力拡張)。既存データ後方互換のため全て任意。
  foremanName      String? // 職長
  vehicles         String? // 使用車両(machineryとは別枠)
  materials        String? // 使用材料
  subcontractors   String? // 協力会社
  startTime        String? // 開始時間 "HH:mm"
  endTime          String? // 終了時間 "HH:mm"
  breakMinutes     Int? // 休憩時間(分)
  overtimeMinutes  Int? // 残業時間(分)
  dangerPrediction String? // 危険予知
  remarks          String? // 備考
  latitude         Float? // GPS取得時点の緯度
  longitude        Float? // GPS取得時点の経度
  capturedAddress  String? // GPSから逆ジオコーディングした取得時点の現場住所(スナップショット)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       DailyReportPhoto[]
  laborEntries DailyReportLaborEntry[]
  ownItems     DailyReportOwnItem[]
  partnerItems DailyReportPartnerItem[]

  @@index([companyId])
  @@index([projectId])
}

enum PhotoPhase {
  BEFORE // 施工前
  DURING // 施工中
  AFTER // 施工後
  UNKNOWN
}

// 現場写真。クラウドストレージ未契約([no-billing-without-confirmation])のため
// SQLiteのBLOBとしてDB内保存するMVP措置。本番で大量・高解像度の写真を扱う場合は
// 外部ストレージ(S3/R2等、要ユーザー確認・課金)への切替を要する(DEPLOYMENT.md参照)。
model DailyReportPhoto {
  id            String      @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  companyId     String // テナント分離をこのテーブル単体でも効かせるため保持
  data          Bytes
  mimeType      String
  // 施工前/中/後。AI自動判定は課金が発生するため今回は対象外 —
  // 手動選択とし、アップロード順による初期値のみアプリ側で提案する。
  phase         PhotoPhase  @default(UNKNOWN)
  takenAt       DateTime? // EXIFのDateTimeOriginal、取得できなければアップロード時刻
  caption       String? // ユーザー入力のコメント(AI自動生成は今回スコープ外)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([dailyReportId])
  @@index([companyId])
}

// 原価集計表(既存Excel「日報ひな形」の氏名・単価・残業・職種表に対応)。
// 単価は給与相当の機微情報のため、音声入力の対象にはせず手動入力のみとする。
model DailyReportLaborEntry {
  id            String      @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  workerName    String
  unitPrice     Int? // 単価(日当)
  overtimeHours Float?
  jobType       String? // 職種

  @@index([dailyReportId])
}

enum OwnItemKind {
  VEHICLE_MACHINERY // 自社持込車両・機械
  MATERIAL // 自社持込材料
}

// 原価集計表の「自社持込車両・機械」「自社持込材料」表
// (元Excelでは同じ行範囲を左右2列組で共有しているが、DBではkindで区別する)
model DailyReportOwnItem {
  id            String      @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  kind          OwnItemKind
  sortOrder     Int         @default(0)
  name          String
  quantity      String?
  amount        Int?

  @@index([dailyReportId])
}

enum PartnerItemKind {
  PARTNER_EQUIPMENT // 協力会社持込資機材
  OTHER_EXPENSE // その他経費
}

// 原価集計表の「協力会社持込資機材」「その他経費」表
model DailyReportPartnerItem {
  id            String          @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport     @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  kind          PartnerItemKind
  sortOrder     Int             @default(0)
  name          String
  quantity      String?
  unitPrice     Int?

  @@index([dailyReportId])
}

// 作業内容マスタ(よく使う作業内容の候補。日報の作業内容欄で候補表示に使う)
model WorkItemMaster {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

enum PlanSectionStatus {
  NEEDS_INPUT // 情報不足で未着手
  DRAFTED // AIが下書きを作成した(未確認)
  NEEDS_CONFIRMATION // 推測を含む・要人間確認
  CONFIRMED // 人間が確認済み
}

model ConstructionPlan {
  id                String                    @id @default(cuid())
  companyId         String
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project                   @relation(fields: [projectId], references: [id])
  templateId        String? // 発注者/自治体別テンプレート
  template          Template?                 @relation(fields: [templateId], references: [id])
  agentName         String? // 現場代理人(後から入力可)
  supervisorName    String? // 主任技術者(後から入力可)
  isSubmissionReady Boolean                   @default(false) // 人間が最終確認するまでfalse
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  sections          ConstructionPlanSection[]

  @@index([companyId])
  @@index([projectId])
}

// 施工計画書の各章(工事概要/施工方針/安全管理...) REQUIREMENTS.md #6 の必須仕様に対応:
// 不足情報の明示・推測箇所の明示・元資料との対応・断定しない、をsection単位で保持する。
model ConstructionPlanSection {
  id               String            @id @default(cuid())
  planId           String
  plan             ConstructionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  sectionKey       String // 例: "工事概要", "施工方針", "安全管理" 等の固定キー
  title            String
  sortOrder        Int               @default(0)
  content          String?
  status           PlanSectionStatus @default(NEEDS_INPUT)
  missingInfoJson  String? // 不足情報のリスト(JSON配列)
  assumedItemsJson String? // 推測で埋めた箇所の明示(JSON配列)
  sourceRefsJson   String? // 元資料(ページ/ファイル名等)との対応(JSON配列)

  @@index([planId])
}

enum TemplateKind {
  QUOTE
  CONSTRUCTION_PLAN
  DAILY_REPORT
}

// 会社別・発注者別のテンプレート(価格表示のひな形、施工計画書の章立てなど)
model Template {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind              TemplateKind
  name              String
  configJson        String // テンプレートごとの設定(章立て・既定文言等)をJSONで保持
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  constructionPlans ConstructionPlan[]

  @@index([companyId])
}

// 操作ログ・アクセスログ(SECURITY.md要件)。個人情報・口座情報・顧客情報の本文は記録しない。
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // 例: "quote.create", "auth.login", "customer.delete"
  targetType String?
  targetId   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

// 契約書・見積書・請求書の自動採番(会社×書類種別×年度で連番)。
// 同時操作でも番号が重複しないよう、採番時は必ずトランザクション内でupdate/createする(src/lib/numbering.ts)。
model NumberSequence {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docType    String // "PROJECT" | "ESTIMATE" | "CONTRACT" | "INVOICE"
  year       Int
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, docType, year])
}

// 消費税額の端数処理方法(REQUIREMENTS.md/税務処理要件)
enum RoundingMode {
  FLOOR // 切り捨て
  ROUND // 四捨五入
  CEIL // 切り上げ
}

enum ContractStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// 工事請負契約書。案件・見積情報から自動反映して作成する(REQUIREMENTS.md #9)。
// 法的有効性を保証するものではなく一般的なひな形である旨を画面上に必ず表示する。
// confirm(契約確定)時にconfirmedSnapshotJsonへ内容を保存し、以後projectやquoteが
// 変更されても確定済み契約書の内容は変わらないようにする。
model Contract {
  id                         String         @id @default(cuid())
  companyId                  String
  company                    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId                  String
  project                    Project        @relation(fields: [projectId], references: [id])
  quoteId                    String? // 参照元見積(任意)
  quote                      Quote?         @relation(fields: [quoteId], references: [id])
  contractNumber             String         @unique
  contractDate               DateTime
  contractAmountExcludingTax Int
  taxRatePercent             Int            @default(10)
  taxAmount                  Int
  contractAmountIncludingTax Int
  roundingMode               RoundingMode   @default(ROUND)
  startDate                  DateTime?
  endDate                    DateTime?
  paymentTerms               String?
  warrantyTerms              String? // 瑕疵・契約不適合対応
  delayTerms                 String? // 工期変更・遅延時の対応
  cancellationTerms          String? // 契約解除条件
  specialTerms               String? // 特約事項
  clausesJson                String // 基本条項本文(JSON配列、章ごとに編集可能)
  status                     ContractStatus @default(DRAFT)
  version                    Int            @default(1)
  confirmedSnapshotJson      String? // 確定時点のスナップショット(JSON)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  invoices                   Invoice[]

  @@index([companyId])
  @@index([projectId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum BillingType {
  FULL // 全額請求
  DEPOSIT // 着手金
  PROGRESS // 中間金/出来高請求
  PARTIAL // 一部請求
  FINAL // 完成時請求
}

// 請求書。契約書・案件情報から作成する(REQUIREMENTS.md #10)。
// 累計請求額が契約金額を超える場合は保存できないようにサーバー側で必ず検証する(src/lib/invoiceCalc.ts)。
// issue(発行)時にissuedSnapshotJsonへ内容を保存し、以後の変更を防ぐ。
model Invoice {
  id                     String        @id @default(cuid())
  companyId              String
  company                Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId              String
  project                Project       @relation(fields: [projectId], references: [id])
  contractId             String?
  contract               Contract?     @relation(fields: [contractId], references: [id])
  invoiceNumber          String        @unique
  issueDate              DateTime
  dueDate                DateTime?
  billingType            BillingType   @default(FULL)
  billingPercentage      Float?
  previousBilledAmount   Int           @default(0)
  currentBilledAmount    Int           @default(0)
  cumulativeBilledAmount Int           @default(0)
  remainingAmount        Int           @default(0)
  subtotal               Int           @default(0)
  taxRatePercent         Int           @default(10)
  taxAmount              Int           @default(0)
  total                  Int           @default(0)
  roundingMode           RoundingMode  @default(ROUND)
  status                 InvoiceStatus @default(DRAFT)
  paidAt                 DateTime? // 入金確認日時(手動で「入金確認」操作した時点)
  notes                  String?
  issuedSnapshotJson     String? // 発行時点のスナップショット(JSON)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  items                  InvoiceItem[]

  @@index([companyId])
  @@index([projectId])
  @@index([contractId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  itemName  String
  spec      String?
  quantity  Float
  unit      String
  unitPrice Int
  remarks   String?

  @@index([invoiceId])
}
