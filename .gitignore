# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets / credentials — never commit (SECURITY.md)
*.pem
*.key
secrets/
credentials/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (local dev only — DATABASE_URL resolves relative to project root, not prisma/)
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal

# generated prisma client
/src/generated/prisma

# uploads (local dev storage stand-in for S3互換ストレージ)
/uploads
